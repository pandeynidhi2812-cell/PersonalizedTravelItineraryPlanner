# Copy this file to .env (run.bat does it for you). Every value is optional.

# Secret used to sign login tokens. Change it for any real deployment.
JWT_SECRET=change-me-to-a-long-random-string

# --- Database Connection (optional) --------------------------------------------
# Defaults to local SQLite (backend/travel.db) if empty.
# For production (e.g. Render PostgreSQL), set your PostgreSQL connection string:
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname
DATABASE_URL=

# --- Deployment & Security (optional) ---------------------------------------
# Comma-separated list of allowed frontend origins. Defaults to localhost:5173.
CORS_ORIGINS=

# --- Generative AI (optional) -------------------------------------------------
# Any OpenAI-compatible endpoint works. Defaults target Groq + Llama-3.
# Leave LLM_API_KEY empty to use the built-in template writer.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant

# --- Supabase (optional) ------------------------------------------------------
# Run supabase_schema.sql in your project, then add the project URL and the service_role key.
SUPABASE_URL=
SUPABASE_KEY=
